<!DOCTYPE html>
<html>

<head>

    <title>All Flashcards</title>

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="stylesheet" href="/css/ui-kit.css">
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>

    <style>
        /* PAGE */

        .page {
            min-height: 100vh;
            padding: 30px;
            position: relative;
            overflow: hidden;
        }

        /* HEADER */

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }


        /* GRID */

        .grid {
            max-width: 1200px;
            margin: 40px auto;

            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 32px;
        }

        /* responsive */

        @media (max-width:1000px) {
            .grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width:600px) {
            .grid {
                grid-template-columns: 1fr;
            }
        }

        /* FLASHCARD */
        /* FLASHCARD */

        .flashcard {
            min-height: 220px;
            width: 100%;
            perspective: 1000px;
            cursor: pointer;
        }

        .inner {
            position: relative;
            width: 100%;
            height: 100%;
            min-height: 220px;

            transform-style: preserve-3d;
            transition: transform .55s;
        }

        .flashcard.flipped .inner {
            transform: rotateY(180deg);
        }

        .flashcard {
            transition: transform .15s ease;
        }

        .flashcard:hover {
            transform: translateY(-4px);
        }

        .side {
            position: absolute;
            inset: 0;

            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;

            padding: 24px;
            text-align: center;
            gap: 12px;

            backface-visibility: hidden;
        }

        .back {
            transform: rotateY(180deg);
            justify-content: space-between;
        }

        /* LABELS */

        .tagRow {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
            justify-content: center;
            margin-bottom: 6px;
        }

        .tag {
            font-size: 11px;
            padding: 3px 8px;
            border-radius: 6px;
            background: #e8e8e8;
        }

        .tag.ai {
            background: #ffe082;
        }

        .tag.subject {
            background: #bbdefb;
        }

        /* ACTIONS */

        .cardActions {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            justify-content: center;
        }

        /* TEST */

        #testBox {
            width: 520px;
            position: relative;
        }

        #timer {
            position: absolute;
            top: 10px;
            right: 20px;
            font-weight: 600;
        }

        .option {
            padding: 10px;
            margin: 8px 0;
            cursor: pointer;
            border-radius: 8px;
        }

        .option.selected {
            background: var(--primary);
        }

        /* FLOATING ICONS */

        .floating {
            position: absolute;
            opacity: .15;
            animation: float 6s ease-in-out infinite;
            pointer-events: none;
        }

        .large {
            font-size: 40px;
        }

        .medium {
            font-size: 30px;
        }

        .small {
            font-size: 22px;
        }

        .i1 {
            top: 8%;
            left: 6%;
        }

        .i2 {
            top: 18%;
            left: 20%;
        }

        .i3 {
            top: 12%;
            right: 10%;
        }

        .i4 {
            top: 30%;
            right: 5%;
        }

        .i5 {
            top: 45%;
            left: 5%;
        }

        .i6 {
            top: 55%;
            right: 15%;
        }

        .i7 {
            bottom: 25%;
            left: 12%;
        }

        .i8 {
            bottom: 18%;
            right: 10%;
        }
    </style>

</head>

<body>

    <div class="top-nav">
        <div class="text-subtitle">StudyMate</div>

        <div class="nav-links">
            <a href="/dashboard">Dashboard</a>
        </div>
    </div>


    <div class="page">

        <!-- floating icons -->

        <i class='bx bx-brain floating large i1'></i>
        <i class='bx bx-book floating medium i2'></i>
        <i class='bx bx-bulb floating medium i3'></i>
        <i class='bx bx-code floating small i4'></i>
        <i class='bx bx-chip floating medium i5'></i>
        <i class='bx bx-network-chart floating small i6'></i>
        <i class='bx bx-bracket floating medium i7'></i>
        <i class='bx bx-atom floating large i8'></i>


        <!-- HEADER -->

        <div class="header">

            <h2 class="text-title">All Flashcards</h2>

            <div class="row">

                <a href="/dashboard" class="btn">
                    <i class='bx bx-home'></i>
                    Home
                </a>

                <button class="btn btn-accent" onclick="startTest()">
                    <i class='bx bx-brain'></i>
                    Test All
                </button>

            </div>

        </div>


        <!-- FLASHCARDS -->

        <div class="grid">

            <% cards.forEach(card=>{ %>

                <div class="flashcard" onclick="flip(this)">

                    <div class="inner">

                        <!-- FRONT -->

                        <div class="side card">

                            <div class="tagRow">

                                <% if(card.createdBy==="ai" ){ %>
                                    <div class="tag ai">
                                        <i class='bx bx-bot'></i> AI
                                    </div>
                                    <% } %>

                                        <% if(card.subjectId){ %>
                                            <div class="tag subject">
                                                <%= card.subjectId %>
                                            </div>
                                            <% } %>

                            </div>

                            <div class="text-subtitle">
                                <%= card.question %>
                            </div>

                        </div>


                        <!-- BACK -->

                        <div class="side card back">

                            <div class="text-muted">
                                <%= card.answer %>
                            </div>

                            <div class="cardActions">

                                <form method="POST" action="/flashcards/<%= card.flashcardId %>/review">

                                    <button class="btn btn-danger" name="rating" value="again">Again</button>
                                    <button class="btn btn-secondary" name="rating" value="hard">Hard</button>
                                    <button class="btn btn-success" name="rating" value="good">Good</button>
                                    <button class="btn btn-primary" name="rating" value="easy">Easy</button>

                                </form>

                                <form method="POST" action="/flashcards/<%= card.flashcardId %>/delete">

                                    <button class="btn btn-danger">
                                        <i class='bx bx-trash'></i>
                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>

                </div>

                <% }) %>

        </div>

    </div>


    <!-- TEST POPUP -->

    <div id="testPopup" class="popup center">

        <div id="testBox" class="card col">

            <div id="timer">0s</div>

            <div id="progress"></div>

            <div id="questionBox"></div>

            <div id="optionsBox"></div>

            <div id="resultBox"></div>

        </div>

    </div>


    <script>

        let questions = []
        let current = 0
        let answers = {}

        let timer = 0
        let timerInterval


        function flip(card) {
            card.classList.toggle("flipped")
        }


        /* TEST */

        async function startTest() {

            const res = await fetch(`/flashcards/test/all/start`)

            questions = await res.json()

            if (questions.length === 0) {
                alert("No flashcards available")
                return
            }

            current = 0
            answers = {}

            document.getElementById("testPopup").style.display = "flex"

            startTimer()
            showQuestion()

        }


        function startTimer() {

            timer = 0

            timerInterval = setInterval(() => {
                timer++
                document.getElementById("timer").innerText = timer + "s"
            }, 1000)

        }


        function showQuestion() {

            const q = questions[current]

            document.getElementById("progress").innerText =
                `Question ${current + 1} / ${questions.length}`

            document.getElementById("questionBox").innerHTML =
                `<h3>${q.question}</h3>`

            let html = ""

            q.options.forEach(opt => {

                html += `
<div class="option" onclick="selectAnswer('${q.flashcardId}', \`${opt}\`)">
${opt}
</div>
`

            })

            document.getElementById("optionsBox").innerHTML = html

        }


        function selectAnswer(id, value) {

            answers[id] = value

            document.querySelectorAll(".option")
                .forEach(o => o.classList.remove("selected"))

            event.target.classList.add("selected")

            setTimeout(() => {
                nextQuestion()
            }, 400)

        }


        function nextQuestion() {

            if (current < questions.length - 1) {

                current++
                showQuestion()

            } else {

                submitTest()

            }

        }


        async function submitTest() {

            clearInterval(timerInterval)

            const res = await fetch(`/flashcards/test/all/submit`, {

                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },

                body: JSON.stringify({
                    answers
                })

            })

            const result = await res.json()

            document.getElementById("questionBox").innerHTML = "<h2>Test Result</h2>"
            document.getElementById("optionsBox").innerHTML = ""

            document.getElementById("resultBox").innerHTML = `
<p>Score: ${result.score}/${result.total}</p>
<p>Percent: ${result.percent}%</p>
<p>Time: ${timer}s</p>
`

        }

    </script>

</body>

</html>