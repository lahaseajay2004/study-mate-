<!DOCTYPE html>
<html>

<head>

    <title>Flashcards</title>

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="stylesheet" href="/css/ui-kit.css">
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>

    <style>
        /* PAGE */

        .page {
            min-height: 100vh;
            padding: 30px;
            position: relative;
            overflow: hidden;
        }

        /* HEADER */

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        /* SCORE CARD */

        .score {
            width: 260px;
        }

        /* GRID */

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }

        /* FLASHCARD */

        .flashcard {
            height: 200px;
            perspective: 1000px;
            cursor: pointer;
        }

        .inner {
            width: 100%;
            height: 100%;
            position: relative;
            transform-style: preserve-3d;
            transition: transform .6s;
        }

        .flashcard.flipped .inner {
            transform: rotateY(180deg);
        }

        .side {
            position: absolute;
            width: 100%;
            height: 100%;
            backface-visibility: hidden;

            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 20px;
        }

        .back {
            transform: rotateY(180deg);
            justify-content: space-between;
        }

        /* ACTION BUTTONS */

        .cardActions {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            justify-content: center;
        }

        /* POPUP */

        .popup {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, .4);
            display: none;
            align-items: center;
            justify-content: center;
        }

        .popupBox {
            width: 420px;
        }

        /* TEST */

        #testBox {
            width: 520px;
            position: relative;
        }

        #timer {
            position: absolute;
            top: 10px;
            right: 20px;
            font-weight: 600;
        }

        .option {
            padding: 10px;
            margin: 8px 0;
            cursor: pointer;
        }

        .option.selected {
            background: var(--primary);
        }

        /* FLOATING ICONS */

        .floating {
            position: absolute;
            opacity: .15;
            animation: float 6s ease-in-out infinite;
            pointer-events: none;
        }

        .small {
            font-size: 22px;
        }

        .medium {
            font-size: 30px;
        }

        .large {
            font-size: 40px;
        }

        .i1 {
            top: 8%;
            left: 6%;
        }

        .i2 {
            top: 18%;
            left: 20%;
        }

        .i3 {
            top: 12%;
            right: 10%;
        }

        .i4 {
            top: 30%;
            right: 5%;
        }

        .i5 {
            top: 45%;
            left: 5%;
        }

        .i6 {
            top: 55%;
            right: 15%;
        }

        .i7 {
            bottom: 25%;
            left: 12%;
        }

        .i8 {
            bottom: 18%;
            right: 10%;
        }

        .i9 {
            bottom: 8%;
            left: 25%;
        }

        .i10 {
            bottom: 5%;
            right: 20%;
        }
    </style>

</head>

<body>

    <div class="top-nav">
        <div class="text-subtitle">StudyMate</div>

        <div class="nav-links">
            <a href="/dashboard">Dashboard</a>
        </div>
    </div>

    <div class="page">

        <!-- floating icons -->

        <i class='bx bx-brain floating large i1'></i>
        <i class='bx bx-book floating medium i2'></i>
        <i class='bx bx-bulb floating medium i3'></i>
        <i class='bx bx-code floating small i4'></i>
        <i class='bx bx-chip floating medium i5'></i>
        <i class='bx bx-network-chart floating small i6'></i>
        <i class='bx bx-bracket floating medium i7'></i>
        <i class='bx bx-atom floating large i8'></i>

        <!-- HEADER -->

        <div class="header">

            <h2 class="text-title">Flashcards</h2>

            <div class="row">

                <a href="/dashboard" class="btn">
                    <i class='bx bx-home'></i>
                    Home
                </a>

                <button class="btn btn-primary" onclick="openCreate()">
                    <i class='bx bx-plus'></i>
                    Add Card
                </button>

                <button class="btn btn-accent" onclick="startTest()">
                    <i class='bx bx-brain'></i>
                    Take Test
                </button>

            </div>

        </div>

        <!-- SCORE -->

        <div class="card score">

            <div class="text-subtitle">Subject Score</div>

            <p>Average: <b>
                    <%= score.averageScore %>%
                </b></p>
            <p>Cards: <%= score.cardCount %>
            </p>

        </div>

        <!-- FLASHCARDS -->

        <div class="grid">

            <% cards.forEach(card=>{ %>

                <div class="flashcard" onclick="flip(this)">

                    <div class="inner">

                        <div class="side card">

                            <div class="text-subtitle">
                                <%= card.question %>
                            </div>

                        </div>

                        <div class="side card back">

                            <div class="text-muted">
                                <%= card.answer %>
                            </div>

                            <div class="cardActions">

                                <form method="POST" action="/flashcards/<%= card.flashcardId %>/review">

                                    <input type="hidden" name="subjectId" value="<%= subjectId %>">

                                    <button class="btn btn-danger" name="rating" value="again">Again</button>
                                    <button class="btn btn-secondary" name="rating" value="hard">Hard</button>
                                    <button class="btn btn-success" name="rating" value="good">Good</button>
                                    <button class="btn btn-primary" name="rating" value="easy">Easy</button>

                                </form>

                                <form method="POST" action="/flashcards/<%= card.flashcardId %>/delete">

                                    <input type="hidden" name="subjectId" value="<%= subjectId %>">

                                    <button class="btn btn-danger">
                                        <i class='bx bx-trash'></i>
                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>

                </div>

                <% }) %>

        </div>

    </div>


    <!-- CREATE POPUP -->

    <div id="createPopup" class="popup center">

        <div class="card popupBox col">

            <div class="row" style="justify-content:space-between">
                <h3>Create Flashcard</h3>
                <span onclick="closeCreate()" style="cursor:pointer">✖</span>
            </div>

            <form method="POST" action="/flashcards/create" class="col">

                <input type="hidden" name="subjectId" value="<%= subjectId %>">

                <input class="input" name="question" placeholder="Question" required>

                <textarea class="input" name="answer" placeholder="Answer"></textarea>

                <button class="btn btn-success">
                    Create
                </button>

            </form>

        </div>

    </div>

    <!-- TEST POPUP -->

    <div id="testPopup" class="popup center">

        <div id="testBox" class="card col">

            <div id="timer">0s</div>

            <div id="progress"></div>

            <div id="questionBox"></div>

            <div id="optionsBox"></div>

            <div id="resultBox"></div>

        </div>

    </div>

    <script>

        const subjectId = "<%= subjectId %>"

        let questions = []
        let current = 0
        let answers = {}

        let timer = 0
        let timerInterval


        function flip(card) {
            card.classList.toggle("flipped")
        }


        function openCreate() {
            document.getElementById("createPopup").style.display = "flex"
        }

        function closeCreate() {
            document.getElementById("createPopup").style.display = "none"
        }


        /* TEST */

        async function startTest() {

            const res = await fetch(`/flashcards/test/${subjectId}/start`)

            questions = await res.json()

            if (questions.length === 0) {
                alert("No flashcards available")
                return
            }

            current = 0
            answers = {}

            document.getElementById("testPopup").style.display = "flex"

            startTimer()

            showQuestion()

        }


        function startTimer() {

            timer = 0

            timerInterval = setInterval(() => {
                timer++
                document.getElementById("timer").innerText = timer + "s"
            }, 1000)

        }


        function showQuestion() {

            const q = questions[current]

            document.getElementById("progress").innerText =
                `Question ${current + 1} / ${questions.length}`

            document.getElementById("questionBox").innerHTML =
                `<h3>${q.question}</h3>`

            let html = ""

            q.options.forEach(opt => {

                html += `
<div class="option" onclick="selectAnswer('${q.flashcardId}', \`${opt}\`)">
${opt}
</div>
`

            })

            document.getElementById("optionsBox").innerHTML = html

        }


        function selectAnswer(id, value) {

            answers[id] = value

            document.querySelectorAll(".option")
                .forEach(o => o.classList.remove("selected"))

            event.target.classList.add("selected")

            setTimeout(() => {
                nextQuestion()
            }, 400)

        }


        function nextQuestion() {

            if (current < questions.length - 1) {

                current++
                showQuestion()

            } else {

                submitTest()

            }

        }


        async function submitTest() {

            clearInterval(timerInterval)

            const res = await fetch(`/flashcards/test/${subjectId}/submit`, {

                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },

                body: JSON.stringify({
                    answers
                })

            })

            const result = await res.json()

            document.getElementById("questionBox").innerHTML = "<h2>Test Result</h2>"
            document.getElementById("optionsBox").innerHTML = ""

            document.getElementById("resultBox").innerHTML = `
<p>Score: ${result.score}/${result.total}</p>
<p>Percent: ${result.percent}%</p>
<p>Time: ${timer}s</p>
`

        }

    </script>

</body>

</html>